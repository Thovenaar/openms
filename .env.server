# Loopback defaults for a dedicated development backend and PostgreSQL container.
# Never use this published development password or database for production.
# Process environment overrides these values from every working directory.
DATABASE_URL=postgres://openms:openms_local_only@127.0.0.1:55432/openms
# Listener address: use a local LAN IP, or 0.0.0.0 / :: to bind all interfaces.
# Non-loopback development exposes HTTP and development accounts to the network;
# use only on trusted networks, with firewall restrictions, never the public internet.
OPENMS_HOST=127.0.0.1
OPENMS_PORT=3200
# Exact browser origin of the online client proxy, not the backend listener.
# Local development also accepts localhost, 127.0.0.1 and [::1] on the same scheme/port.
# For LAN access, set the actual browser hostname/IP and online-client port here.
# Wildcard bind addresses (0.0.0.0 / ::) are not browser origins.
OPENMS_ORIGIN=http://127.0.0.1:3102
# Separate Studio browser origin; admits login and content authoring, not gameplay.
OPENMS_STUDIO_ORIGIN=http://127.0.0.1:3103
OPENMS_POW_BITS=15
# Development accounts: admin/password and player/password.
# OPENMS_DEV_PASSWORD optionally overrides the password for both on each launch.
# Production: securely inject DATABASE_URL, HTTPS OPENMS_ORIGIN and reviewed
# OPENMS_RULES_HASH; run server/src/index.js, never server/tools/dev.js.
# OPENMS_MODE is accepted only from process environment, not this local file.
# Keep secrets outside tracked files; .env*.local files are ignored, not auto-loaded.
