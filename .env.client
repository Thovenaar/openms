# Host-tool defaults shared by offline/online dev and browser build entrypoints.
# Programmatic options override process environment, which overrides this file.
# Bind each listener to a local IP/hostname; use 0.0.0.0 to listen on all IPv4 interfaces.
HOST=127.0.0.1
PORT=3100
ONLINE_HOST=127.0.0.1
ONLINE_PORT=3102
# Reachable backend HTTP origin (including its port), not a wildcard listener address.
# For LAN access, the backend OPENMS_ORIGIN must match the online browser origin exactly.
OPENMS_SERVER_URL=http://127.0.0.1:3200
# These listener/proxy values apply only to development serving.
# Production output always uses same-origin /api/ and static /generated/ mounts;
# configure their HTTPS reverse proxy in deployment, not browser credentials.
# No server credentials or arbitrary environment namespace enter the bundle.
