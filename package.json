{
  "name": "openms.dev",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "server:dev": "bun server/tools/dev.js",
    "server:start": "bun server/src/index.js",
    "client:dev:offline": "bun client/tools/dev.js",
    "client:dev:online": "bun client/tools/dev-online.js",
    "client:build:online": "bun client/tools/build-online.js",
    "dev:docs": "bunx --bun vitepress dev docs",
    "docs:check": "bun docs/tools/check.js",
    "docs:build": "bunx --bun vitepress build docs",
    "docs:preview": "bunx --bun vitepress preview docs",
    "test": "bun test",
    "lint": "bunx --bun eslint . --max-warnings 0",
    "format": "bunx --bun prettier --write 'tools/**/*.js' 'client/src/**/*.js' 'client/tools/**/*.js' 'client/test/**/*.js' 'client/public/*.js' 'server/src/**/*.js' 'server/tools/**/*.js' 'server/test/**/*.js' 'shared/**/*.js' client/public/app.webmanifest client/index.html client/style.css client/online.css eslint.config.js package.json client/package.json server/package.json"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "acorn": "8.18.0",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "mermaid": "12.0.0",
    "prettier": "3.8.1",
    "vitepress": "1.6.4",
    "vue": "3.5.42"
  }
}
