# Copy to .env.studio before starting Studio; the local copy is ignored by Git.
# Studio has its own listener. It does not require the game client listener.
# Programmatic options override process environment, which overrides this file.
STUDIO_HOST=127.0.0.1
STUDIO_PORT=3103
# API requests retain the Studio browser Origin. If changing its public port/host,
# update OPENMS_STUDIO_ORIGIN in .env.server to the matching browser origin.
OPENMS_SERVER_URL=http://127.0.0.1:3200
# Public game link only; no requests depend on the game listener being available.
OPENMS_CLIENT_URL=http://127.0.0.1:3102
# Existing immutable extraction, resolved relative to the repository root.
# Keep this aligned with the backend's OPENMS_CONTENT_ROOT.
OPENMS_CONTENT_ROOT=client/public/generated
