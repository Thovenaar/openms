# Build with `bun client/tools/build-online.js`; run `bun run server:prod`.
# Set OPENMS_ORIGIN=https://openms.dev in .env.server. No client listener is needed.
# Debian checkout: Caddy needs traversal through parent directories and read access
# to both public trees. The build puts only catalog.json in site/generated/;
# the remaining generated assets stay in client/public/generated/.
# Regenerate any precompressed sidecars whenever the original files change.
# Compatible with Caddy 2.6; avoid newer header response-status matchers.
openms.dev {
	root * /home/debian/openms/client/dist/online/site

	log
	encode zstd gzip

	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	route {
		# Preserve /api/ and connect directly to the game server, including WebSockets.
		handle /api/* {
			reverse_proxy 127.0.0.1:3200
		}

		# Serve the catalog captured by this client build before the generated mount.
		handle /generated/catalog.json {
			file_server {
				precompressed
			}
		}

		# Strip /generated/ before resolving the asset filename.
		handle_path /generated/* {
			root * /home/debian/openms/client/public/generated

			# Content-hashed assets are immutable; errors override this below.
			@immutable path_regexp immutable ^/([a-z][a-z0-9-]*/)+[a-f0-9]{64}[.](png|json|mp3|wav|bin)$
			header @immutable Cache-Control "public, max-age=31536000, immutable"

			file_server {
				precompressed
			}
		}

		# HTML, CSS, JavaScript, icons and worker files retain their published paths.
		handle {
			file_server {
				precompressed
			}
		}
	}

	# Missing or unreadable assets must not inherit immutable caching.
	handle_errors {
		header Cache-Control "no-store"
		respond "{http.error.status_text}" {http.error.status_code}
	}
}
